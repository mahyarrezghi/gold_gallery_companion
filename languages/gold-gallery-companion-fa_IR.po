# Plugin Name and Description
msgid "Gold Gallery Companion"
msgstr "افزونه طلا ووکامرس"

msgctxt "Plugin description"
msgid "WooCommerce plugin for selling gold products with automatic price calculation based on Iranian gold pricing formula"
msgstr "افزونه ووکامرس برای فروش محصولات طلا با محاسبه خودکار قیمت بر اساس فرمول قیمت‌گذاری طلای ایران"

